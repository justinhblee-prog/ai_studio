export const MAX_STEPS: number;
export type StepParam = { key: string; label: string; type: 'int' | 'color'; min?: number; max?: number; value: number | string };
export const STEP_DEFS: Readonly<Record<string, { label: string; help: string; params: StepParam[] }>>;
export type Step = { op: string; [key: string]: any };
export function newStep(op: string): Step;
export function validateSteps(steps: Step[] | null | undefined): string;
export function moveStep(steps: Step[], index: number, delta: number): Step[];
export function summarizeRecords(records: { op: string; size_in: number[]; size_out: number[] }[] | null | undefined): string[];
export function runPhotoSteps(api: string, token: string, workspaceId: string, assetId: string, steps: Step[]): Promise<{ asset: { asset_id: string; original_filename: string }; steps: any[] }>;
export type Preset = { preset_id: string; name: string; steps: Step[] };
export function listPresets(api: string, token: string, workspaceId: string): Promise<{ items: Preset[] }>;
export function savePreset(api: string, token: string, workspaceId: string, name: string, steps: Step[]): Promise<Preset>;
export function deletePreset(api: string, token: string, workspaceId: string, presetId: string): Promise<null>;
export function stepsFromPreset(preset: Preset | null | undefined): Step[];
export function validatePresetName(name: string, existing?: { name: string }[]): string;
export const MAX_BULK_FILES: number;
export const PLANNED_STEPS: readonly string[];
export function planBulk(files: ArrayLike<{ name: string }> | null | undefined): { accepted: any[]; skipped: { name: string; reason: string }[] };
export function uploadMany(api: string, token: string, workspaceId: string, files: any[], declaration: { rightsConfirmed: boolean; depictsPerson: boolean; likenessConsent: boolean }, upload?: (...args: any[]) => Promise<any>): Promise<{ done: { name: string; asset: any }[]; failed: { name: string; reason: string; status?: number }[] }>;
