# Public browser configuration only. Never put service-role keys here.
# Release builds (npm run build) use ONLY this value; the address input and saved overrides are removed (L-13).
# Development builds let you edit and remember the address in the browser.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
