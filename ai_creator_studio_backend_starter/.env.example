# Safe default: no external generation calls
PROVIDER_MODE=mock
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai
# Choose tryon-v1.6 for speed/cost or tryon-max for higher-fidelity 1k/2k/4k outputs
FASHN_MODEL=tryon-v1.6
HTTP_TIMEOUT_SECONDS=30
OUTPUT_DIR=./outputs
MAX_OUTPUT_BYTES=26214400
FASHN_OUTPUT_HOSTS=cdn.fashn.ai,media.fashn.ai

# Private 3D asset API (configure unique secrets before enabling)
ASSET_API_TOKENS=replace-with-long-random-token:local-user
ASSET_SIGNING_SECRET=replace-with-at-least-32-random-bytes
ASSET_STORAGE_DIR=./private_assets
ASSET_DATABASE_PATH=./assets.sqlite3
ASSET_MAX_UPLOAD_BYTES=104857600
ASSET_PREVIEW_TTL_SECONDS=300
APP_CORS_ORIGINS=http://localhost:5173

# Durable generation job/execution/event/output metadata database (defaults to ASSET_DATABASE_PATH)
GENERATION_DATABASE_PATH=./generation.sqlite3

# Durable outbox dispatch worker tuning
OUTBOX_POLL_SECONDS=1.0
OUTBOX_LEASE_SECONDS=90

# Dedicated Provider status-poll / output-persistence worker
POLL_WORKER_POLL_SECONDS=1.0
POLL_WORKER_LEASE_SECONDS=90
POLL_RETRY_BASE_SECONDS=2
POLL_RETRY_MAX_SECONDS=300
POLL_RETRY_MAX_ATTEMPTS=12
POLL_RETRY_AFTER_MAX_SECONDS=900

# Cross-database Generation Output → Asset/AssetVersion linker worker
OUTPUT_ASSET_LINK_WORKER_LEASE_SECONDS=120
OUTPUT_ASSET_LINK_WORKER_POLL_SECONDS=2
OUTPUT_ASSET_LINK_WORKER_MAX_ATTEMPTS=5

WORKER_STALE_AFTER_SECONDS=30

# Operations monitoring and alert delivery (webhook optional; HTTPS only)
OPS_MONITOR_POLL_SECONDS=5
OPS_ALERT_WORKER_STALE_SECONDS=45
OPS_ALERT_QUEUE_AGE_SECONDS=120
REQUIRED_WORKER_TYPES=outbox,provider_poll,output_asset_link
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_TOKEN=
OPS_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
OPS_ALERT_WEBHOOK_MAX_ATTEMPTS=8
OPS_ADMIN_USER_IDS=

# Storage backend selection. Only sqlite is currently implemented.
# Setting postgresql fails closed until the PostgreSQL adapter passes live integration tests.
DATABASE_BACKEND=sqlite
# DATABASE_URL is reserved for the future PostgreSQL adapter; currently unused.
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_creator_studio

# Supabase Auth token validation (required for hosted user sessions)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# L-04: require a rights declaration (and likeness consent when a person is shown) for image uploads. Default false.
ASSET_REQUIRE_RIGHTS_CONFIRMATION=false
# Cost control: max generation jobs a workspace may create per UTC day (0 = unlimited, the default).
GENERATION_DAILY_JOB_LIMIT_PER_WORKSPACE=0

# Deep health (GET /internal/ops/health): where backups are written and when to warn.
BACKUP_DIR=
HEALTH_DISK_WARN_FREE_PERCENT=15
HEALTH_DISK_FAIL_FREE_PERCENT=5
HEALTH_BACKUP_MAX_AGE_HOURS=26

# Access log (L-05): one JSON line per request, no query strings/tokens. ACCESS_LOG_DIR empty = stdout. Retention default is a placeholder.
ACCESS_LOG_ENABLED=true
ACCESS_LOG_DIR=
ACCESS_LOG_RETENTION_DAYS=30
ACCESS_LOG_ACTOR=hash
ACCESS_LOG_CLIENT_IP=false
